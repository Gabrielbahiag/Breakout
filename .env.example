# Copie para .env (que NÃO é versionado) e preencha para desenvolvimento local.
# Em produção, estes valores vêm dos Secrets do GitHub Actions / Streamlit —
# nunca do disco da máquina do trabalho.

# Chave da YouTube Data API v3 (Google Cloud Console).
YOUTUBE_API_KEY=

# Turso (produção). Deixe VAZIO em dev para usar o SQLite local automaticamente.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Storage local (usado quando TURSO_DATABASE_URL está vazio).
LOCAL_DB_PATH=data/breakout.db

# GitHub PAT fine-grained (escopo Actions, só este repo) — habilita os botões
# "Disparar collect/discover agora" no dashboard. Deixe VAZIO em dev: os
# botões ficam visíveis e desabilitados, sem precisar do token pra rodar.
GITHUB_DISPATCH_TOKEN=

# Fallback de transcrição via Whisper (Fase 7) — só usado por `discover`,
# nunca localmente (precisa do extra [whisper]: faster-whisper + yt-dlp,
# que não instala na máquina de trabalho sem [prod]). Deixe "false": legenda
# do YouTube é sempre tentada primeiro; Whisper só roda quando não há
# legenda nenhuma E isto está "true".
WHISPER_FALLBACK_ENABLED=false
