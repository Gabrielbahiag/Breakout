# Copie para .env (que NÃO é versionado) e preencha para desenvolvimento local.
# Em produção, estes valores vêm dos Secrets do GitHub Actions / Streamlit —
# nunca do disco da máquina do trabalho.

# Chave da YouTube Data API v3 (Google Cloud Console).
YOUTUBE_API_KEY=

# Turso (produção). Deixe VAZIO em dev para usar o SQLite local automaticamente.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Storage local (usado quando TURSO_DATABASE_URL está vazio).
LOCAL_DB_PATH=data/breakout.db
